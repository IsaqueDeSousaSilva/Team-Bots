        text token_hash PK
        int usuario_id FK
        text expira_em
    }
    disciplinas {
        int id PK
        text slug UK
        text nome
    }
    cursos {
        int id PK
        int disciplina_id FK
        text slug UK
        text titulo
        text etapa
        int publicado
    }
    aulas {
        int id PK
        int curso_id FK
        int ordem
        text titulo
        text tipo
        text recurso_url
