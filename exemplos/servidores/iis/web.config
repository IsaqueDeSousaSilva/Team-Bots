<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS — coloque este arquivo DENTRO da pasta simulador/Build/
  Sem ele, o IIS responde "404" para os arquivos .unityweb (extensão desconhecida).
-->
<configuration>
  <system.webServer>
    <!-- Os arquivos já estão compactados: o IIS não deve compactar de novo. -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    <staticContent>
      <remove fileExtension=".unityweb" />
      <mimeMap fileExtension=".unityweb" mimeType="application/octet-stream" />
    </staticContent>
  </system.webServer>

  <location path="WebGL.wasm.unityweb">
    <system.webServer>
      <staticContent>
        <remove fileExtension=".unityweb" />
        <mimeMap fileExtension=".unityweb" mimeType="application/wasm" />
      </staticContent>
      <httpProtocol><customHeaders><add name="Content-Encoding" value="gzip" /></customHeaders></httpProtocol>
    </system.webServer>
  </location>
  <location path="WebGL.framework.js.unityweb">
    <system.webServer>
      <staticContent>
        <remove fileExtension=".unityweb" />
        <mimeMap fileExtension=".unityweb" mimeType="application/javascript" />
      </staticContent>
      <httpProtocol><customHeaders><add name="Content-Encoding" value="gzip" /></customHeaders></httpProtocol>
    </system.webServer>
  </location>
  <location path="WebGL.data.unityweb">
    <system.webServer>
      <httpProtocol><customHeaders><add name="Content-Encoding" value="gzip" /></customHeaders></httpProtocol>
    </system.webServer>
  </location>
</configuration>
